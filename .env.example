# Watphou Travels — environment variable names only (never put real values in git)

# Demo VPS (sm host)
DEMO_SSH_HOST=sm
DEMO_SSH_USER=root
DEMO_WEB_ROOT=/var/www/watphou-demo
DEMO_URL=https://watphou.smbistro.duckdns.org
DEMO_DB_NAME=watphou_demo
DEMO_DB_USER=watphou_demo
DEMO_DB_PASSWORD=
DEMO_BASIC_AUTH_USER=
DEMO_BASIC_AUTH_PASSWORD=

# WordPress
WP_ENV=demo
WP_HOME=
WP_SITEURL=

# Email (server-only; also wp-content/watphou-smtp-secrets.php — never commit values)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
WATPHOU_SMTP_HOST=
WATPHOU_SMTP_PORT=
WATPHOU_SMTP_USER=
WATPHOU_SMTP_PASS=
WATPHOU_SMTP_SECURE=
WATPHOU_SMTP_FROM=
WATPHOU_SMTP_FROM_NAME=

# BCEL payment (production only — not available yet)
BCEL_MERCHANT_ID=
BCEL_API_ENDPOINT=
BCEL_SIGNING_KEY=
BCEL_CALLBACK_SECRET=
BCEL_MODE=sandbox

# Analytics placeholders
GA4_MEASUREMENT_ID=
GSC_VERIFICATION=

# Google Places Application Programming Interface (Place Details). Server-only; never commit the value.
# Restrict the key to Places Application Programming Interface for this website.
WATPHOU_GOOGLE_PLACES_KEY=
