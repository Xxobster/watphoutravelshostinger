{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "primary", "color": "#f15a24", "name": "Brand Orange" },
        { "slug": "secondary", "color": "#d9480f", "name": "Orange Dark" },
        { "slug": "dark", "color": "#2C2C2C", "name": "Charcoal" },
        { "slug": "light", "color": "#FAFAF8", "name": "Off White" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
        { "slug": "hero", "size": "clamp(2rem, 4vw, 3rem)", "name": "Hero" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "30", "size": "1rem", "name": "1" },
        { "slug": "40", "size": "1.5rem", "name": "2" },
        { "slug": "50", "size": "2.5rem", "name": "3" },
        { "slug": "60", "size": "4rem", "name": "4" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--light)", "text": "var(--wp--preset--color--dark)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system-sans)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "heading": { "color": { "text": "var(--wp--preset--color--dark)" }, "typography": { "fontWeight": "700" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--secondary)", "text": "var(--wp--preset--color--dark)" },
        "border": { "radius": "4px" },
        ":hover": { "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--white)" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "0.95rem" } }
    }
  }
}
